# =====================================================================
# CRAG Project Environment Configuration (Placeholder Template)
# Copy this file to .env and supply your local credentials.
# NEVER commit the .env file containing real API keys to version control.
# =====================================================================

# Environment mode: 'development', 'testing', or 'production'
ENVIRONMENT=development

# Retrieval Engine Configuration
SPARSE_BACKEND=bm25s              # Options: 'bm25s' (default, cross-platform) or 'pyserini' (requires Java JDK)
BM25_K1=1.5
BM25_B=0.75
DENSE_MODEL_NAME=all-MiniLM-L6-v2 # SentenceTransformers model for dense retrieval
RRF_K=60                          # Reciprocal Rank Fusion constant

# Index and Data Storage Paths
BM25_INDEX_DIR=indexes/bm25
FAISS_INDEX_DIR=indexes/faiss
DATA_PROCESSED_DIR=data/processed
DATA_SYNTHETIC_DIR=data/synthetic

# LLM-as-a-Judge API Configuration (For Workstream A - Synthetic Data Generation)
# Leave empty during initial offline testing
LLM_PROVIDER=openai               # Options: 'openai', 'anthropic', 'mock'
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
